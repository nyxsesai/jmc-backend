NODE_ENV=development

PORT=3500
HOST=0.0.0.0

# Local Docker DB
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/YOUR_DB
# Remote DB (staging/production) — uncomment when needed
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:6005/YOUR_DB

JWT_SECRET=replace-with-64-char-random-hex
JWT_EXPIRES_IN=7d

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-admin-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"